# Copy to .env and fill in real values. Never commit .env.

# Server
PORT=
# development locally, production on Render
NODE_ENV=

# MongoDB Atlas connection string (mongodb+srv://...)
MONGODB_URI=
# Long random string, at least 32 characters
JWT_SECRET=
# Where the frontend runs, e.g. http://localhost:5173 locally (used for CORS and email links)
FRONTEND_URL=
# Google OAuth client ID (same value as VITE_GOOGLE_CLIENT_ID in the frontend)
GOOGLE_CLIENT_ID=

# Email reminders (Phase 8)
RESEND_API_KEY=
# Long random string; must match the CRON_SECRET GitHub Actions secret
CRON_SECRET=
# Optional, defaults to "Jomnoub <onboarding@resend.dev>"
EMAIL_FROM=

# File attachments: Cloudflare R2. Without these, files are stored in the database.
# Check them with: npm run check:storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Demo data (npm run seed): the Google email of an existing Jomnoub user
SEED_EMAIL=
